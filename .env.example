# Optional for the device-only preview. Configure all three for account-backed cards.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Apple Wallet signing secrets, used only on the server.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_ORGANIZATION_NAME=Universal Card
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_WWDR_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
